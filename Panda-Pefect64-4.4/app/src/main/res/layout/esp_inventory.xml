<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/inventory_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INVENTORY / LOOT"
        android:textColor="#33B5E5"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:weightSum="4">
        
        <LinearLayout
            android:id="@+id/itemscheckall"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@drawable/blue_button_bg"
            android:gravity="center"
            android:layout_marginEnd="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALL ITM" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemsblockall"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="#333333"
            android:gravity="center"
            android:layout_marginEnd="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NONE ITM" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mobilscheckall"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@drawable/blue_button_bg"
            android:gravity="center"
            android:layout_marginEnd="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALL VEH" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mobilsblockall"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="#333333"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NONE VEH" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/menu2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Vehicle Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VEHICLES"
                android:textColor="#33B5E5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:id="@+id/lyvehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">
                <CheckBox android:id="@+id/UTV" android:text="UTV" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/MonsterTruck" android:text="MonsterTruck" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Buggy" android:text="Buggy" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/UAZ" android:text="UAZ" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Trike" android:text="Trike" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Jet" android:text="Jet" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/CoupeRB" android:text="CoupeRB" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Motorglider" android:text="Motorglider" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Bike" android:text="Bike" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Dacia" android:text="Dacia" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Boat" android:text="Boat" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Bus" android:text="Bus" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Mirado" android:text="Mirado" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Snowbike" android:text="Snowbike" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Scooter" android:text="Scooter" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Rony" android:text="Rony" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Snowmobile" android:text="Snowmobile" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Tempo" android:text="Tempo" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/Truck" android:text="Truck" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/LadaNiva" android:text="LadaNiva" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/BRDM" android:text="BRDM" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                <CheckBox android:id="@+id/ATV" android:text="ATV" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
            </GridLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp" />

            <!-- Items Section -->
            <LinearLayout
                android:id="@+id/items1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPECIAL ITEMS"
                    android:textColor="#33B5E5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">
                    <CheckBox android:id="@+id/lootbox" android:text="Lootbox" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Crate" android:text="Crate" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Airdrop" android:text="Airdrop" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/DropPlane" android:text="Plane" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/FlareGun" android:text="FlareGun" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCOPES"
                    android:textColor="#33B5E5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3">
                    <CheckBox android:id="@+id/x8" android:text="8X" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/x6" android:text="6X" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/x4" android:text="4X" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/x3" android:text="3X" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/x2" android:text="2X" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/reddot" android:text="RedDot" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/hollow" android:text="Holo" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/canted" android:text="Canted" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEAPONS (AR)"
                    android:textColor="#33B5E5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">
                    <CheckBox android:id="@+id/m416" android:text="M416" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/AKM" android:text="AKM" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/M16A4" android:text="M16A4" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/M762" android:text="M762" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/SCARL" android:text="SCAR-L" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/AUG" android:text="AUG" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Groza" android:text="Groza" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/QBZ" android:text="QBZ" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/G36C" android:text="G36C" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/FAMAS" android:text="FAMAS" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/HoneyBadger" android:text="Honey Badger" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/AC32" android:text="ACE32" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEAPONS (SNIPER/DMR)"
                    android:textColor="#33B5E5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">
                    <CheckBox android:id="@+id/AWM" android:text="AWM" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Kar98k" android:text="Kar98k" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/M24" android:text="M24" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Mosin" android:text="Mosin" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/AMR" android:text="Lynx AMR" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Win94" android:text="Win94" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/SKS" android:text="SKS" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/SLR" android:text="SLR" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Mini14" android:text="Mini14" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/MK14" android:text="MK14" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/MK12" android:text="MK12" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/QBU" android:text="QBU" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/VSS" android:text="VSS" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/MK47" android:text="MK47 Mutant" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEAPONS (SMG/LMG)"
                    android:textColor="#33B5E5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">
                    <CheckBox android:id="@+id/UMP" android:text="UMP45" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/vector" android:text="Vector" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/UZI" android:text="Micro UZI" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/TommyGun" android:text="Tommy Gun" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/bizon" android:text="PP-19 Bizon" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/MP5K" android:text="MP5K" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/P90" android:text="P90" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/M249" android:text="M249" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/DP28" android:text="DP-28" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/MG3" android:text="MG3" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEAPONS (SHOTGUN/PISTOL)"
                    android:textColor="#33B5E5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">
                    <CheckBox android:id="@+id/S12K" android:text="S12K" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/S1897" android:text="S1897" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/S686" android:text="S686" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/DBS" android:text="DBS" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/M1014" android:text="M1014" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/NS2000" android:text="NS2000" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/sawed" android:text="Sawed-off" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/P92" android:text="P92" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/P1911" android:text="P1911" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/P18C" android:text="P18C" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/R45" android:text="R45" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/R1895" android:text="R1895" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Scorpion" android:text="Skorpion" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Desert" android:text="Deagle" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HANDY / THROWABLES"
                    android:textColor="#33B5E5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">
                    <CheckBox android:id="@+id/Pan" android:text="Pan" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Machete" android:text="Machete" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Sickle" android:text="Sickle" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Crowbar" android:text="Crowbar" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Crossbow" android:text="Crossbow" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/Explosive" android:text="Explosive" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/grenade" android:text="Grenade" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/molotov" android:text="Molotov" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/smoke" android:text="Smoke" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/stun" android:text="Stun" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AMMO / BULLETS"
                    android:textColor="#33B5E5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3">
                    <CheckBox android:id="@+id/a9" android:text="9mm" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/a7" android:text="7.62" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/a5" android:text="5.56" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/a12" android:text="12g" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/a300" android:text="300M" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/a45" android:text=".45" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/arrow" android:text="Bolt" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/BMG50" android:text=".50" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EQUIPMENT (BAG/HELMET/VEST)"
                    android:textColor="#33B5E5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">
                    <CheckBox android:id="@+id/bag1" android:text="Bag Lv 1" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/helmet1" android:text="Helmet Lv 1" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/bag2" android:text="Bag Lv 2" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/helmet2" android:text="Helmet Lv 2" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/bag3" android:text="Bag Lv 3" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/helmet3" android:text="Helmet Lv 3" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/vest1" android:text="Vest Lv 1" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/vest2" android:text="Vest Lv 2" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/vest3" android:text="Vest Lv 3" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

