                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">
                    <CheckBox android:id="@+id/bandage" android:text="Bandage" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/medkit" android:text="MedKit" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/firstaid" android:text="First Aid" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/injection" android:text="Adrenaline" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/painkiller" android:text="Painkiller" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                    <CheckBox android:id="@+id/energydrink" android:text="Energy Drink" android:textColor="#BBBBBB" android:buttonTint="#33B5E5" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
