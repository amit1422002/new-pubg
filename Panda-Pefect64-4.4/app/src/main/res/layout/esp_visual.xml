<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/visual_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESP VISUALS"
        android:textColor="#33B5E5"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbarThumbVertical="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/menucrash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                
                <ImageView android:id="@+id/imgfixedd" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <Switch
                    android:id="@+id/iscrash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crash Fix"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuisland"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                
                <ImageView android:id="@+id/imgisland" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <Switch
                    android:id="@+id/isisland"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Block Report"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Section: Main Toggles -->
            <Switch
                android:id="@+id/isenableesp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MASTER ESP SWITCH"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"
                android:thumbTint="#33B5E5"
                android:trackTint="#6633B5E5" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginBottom="10dp" />

            <!-- Section: Boxes & Lines -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <CheckBox
                    android:id="@+id/isBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2D BOX"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />

                <CheckBox
                    android:id="@+id/isline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LINES"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <CheckBox
                    android:id="@+id/isskeleton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SKELETON"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />

                <CheckBox
                    android:id="@+id/ishead"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HEAD CIRCLE"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />
            </LinearLayout>

            <!-- Section: Player Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <CheckBox
                    android:id="@+id/isName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PLAYER NAME"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />

                <CheckBox
                    android:id="@+id/ishealth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HEALTH BAR"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <CheckBox
                    android:id="@+id/isdistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DISTANCE"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />

                <CheckBox
                    android:id="@+id/isalert"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="360 ALERT"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />
            </LinearLayout>

            <!-- Section: Effects -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <CheckBox
                    android:id="@+id/isaura"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AURA EFFECT"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />

                <CheckBox
                    android:id="@+id/isPlayerElectric"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ELECTRIC"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />
            </LinearLayout>

            <!-- Section: Items & Other -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <CheckBox
                    android:id="@+id/isweapon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WEAPON NAME"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />

                <CheckBox
                    android:id="@+id/isweaponicon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WEAPON ICON"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <CheckBox
                    android:id="@+id/isthrowables"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GRENADES"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />

                <CheckBox
                    android:id="@+id/isnobot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="IGNORE BOTS"
                    android:textColor="#BBBBBB"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="#33B5E5" />
            </LinearLayout>
            
            <CheckBox
                android:id="@+id/islootbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEAD BOX"
                android:textColor="#BBBBBB"
                android:textStyle="bold"
                android:textSize="11sp"
                android:buttonTint="#33B5E5"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
