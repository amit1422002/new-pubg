<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="start|end"
    tools:ignore="HardcodedText, UseSwitchCompatOrMaterialXml, UselessParent, TooManyViews">

    <!-- Outer Horizontal Layout -->
    <LinearLayout
        android:id="@+id/layout_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Hidden Control Icon -->
        <RelativeLayout
            android:id="@+id/layout_icon_control_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageview_control"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher" />
        </RelativeLayout>

        <!-- Main Floating Panel -->
        <LinearLayout
            android:id="@+id/layout_main_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp"
            android:visibility="visible">

            <!-- Sidebar -->
            <LinearLayout
                android:id="@+id/drag_area"
                android:layout_width="75dp"
                android:layout_height="320dp"
                android:background="@drawable/sidebar_bg"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- Tab 1: Main (Crown) -->
                <ImageView
                    android:id="@+id/nav_main"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:padding="12dp"
                    android:src="@drawable/baseline_diamond_24"
                    android:background="@drawable/tab_button_bg"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Tab 2: ESP (Rocket) -->
                <ImageView
                    android:id="@+id/nav_esp_new"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:padding="12dp"
                    android:src="@drawable/baseline_send_24"
                    android:rotation="-45"
                    android:background="@drawable/tab_button_bg"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Tab 3: Settings (Gear) -->
                <ImageView
                    android:id="@+id/nav_settings_new"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:padding="12dp"
                    android:src="@drawable/baseline_settings_24"
                    android:background="@drawable/tab_button_bg"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Close Button (X in Blue Circle) -->
                <ImageView
                    android:id="@+id/layout_close_main_view"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="10dp"
                    android:src="@drawable/baseline_close_24"
                    android:background="@drawable/tab_button_bg"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Main Content Panel -->
            <FrameLayout
                android:id="@+id/content_panel"
                android:layout_width="340dp"
                android:layout_height="320dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/content_bg">

                <!-- New ESP Tab -->
                <include 
                    android:id="@+id/tab_esp_new_container"
                    layout="@layout/esp_tab_new"
                    android:visibility="gone" />

                <!-- Container for original tabs -->
                <FrameLayout
                    android:id="@+id/tab_original_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible">
                    
                    <include android:id="@+id/menuf1" layout="@layout/esp_visual" android:visibility="gone"/>
                    <include android:id="@+id/menuf2" layout="@layout/esp_inventory" android:visibility="gone"/>
                    <include android:id="@+id/menuf3" layout="@layout/esp_aimbot" android:visibility="visible"/>
                    <include android:id="@+id/menuf4" layout="@layout/esp_memory" android:visibility="gone"/>
                    <include android:id="@+id/menuf5" layout="@layout/esp_skin" android:visibility="gone"/>
                </FrameLayout>

            </FrameLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>