<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#000000">

    <TextView
        android:id="@+id/aimbot_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dominator Loader / Aimbot"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:isScrollContainer="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Master Aimbot Switch (Switch itself doesn't have textStyle but its label/text does) -->
            <Switch
                android:id="@+id/aim_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MASTER AIMBOT"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:padding="10dp"
                android:thumbTint="#33B5E5"
                android:trackTint="#6633B5E5"
                android:layout_marginBottom="15dp" />

            <TextView android:id="@+id/aimpre" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Premium Required" android:textColor="#FF0000" android:gravity="center" android:visibility="gone" android:textStyle="bold" android:textSize="10sp" />

            <!-- Container for Premium Content -->
            <LinearLayout
                android:id="@+id/aimsec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Section: Basic Settings -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Basic Settings"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/blue_header_bg"
                    android:layout_marginBottom="15dp" />

                <!-- Distance Slider -->
                <TextView
                    android:id="@+id/distancetext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance : 20"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <SeekBar
                    android:id="@+id/distances"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="500"
                    android:progress="20"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb"
                    android:splitTrack="false"
                    android:layout_marginBottom="20dp" />

                <!-- Range Slider (FOV) -->
                <TextView
                    android:id="@+id/rangetext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aimbot FOV : 20"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <SeekBar
                    android:id="@+id/range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="300"
                    android:progress="20"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb"
                    android:splitTrack="false"
                    android:layout_marginBottom="20dp" />

                <!-- Bullet Speed / Prediction -->
                <TextView
                    android:id="@+id/bulletspeedtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prediction Speed : 0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <SeekBar
                    android:id="@+id/bulletspeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="50"
                    android:progress="0"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb"
                    android:splitTrack="false"
                    android:layout_marginBottom="20dp" />

                <!-- Section: Recoil Customization -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recoil Customization"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/blue_header_bg"
                    android:layout_marginBottom="15dp" />

                <!-- Recoil 1 -->
                <TextView
                    android:id="@+id/recoiltext2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recoil (Vertical) : 0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <SeekBar
                    android:id="@+id/Recoil2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb"
                    android:splitTrack="false"
                    android:layout_marginBottom="20dp" />

                <!-- Recoil 2 -->
                <TextView
                    android:id="@+id/recoiltext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recoil (Horizontal) : 0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <SeekBar
                    android:id="@+id/Recoil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb"
                    android:splitTrack="false"
                    android:layout_marginBottom="20dp" />

                <!-- Recoil 3 -->
                <TextView
                    android:id="@+id/recoiltexts2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recoil (Camera) : 0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <SeekBar
                    android:id="@+id/Recoils2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb"
                    android:splitTrack="false"
                    android:layout_marginBottom="20dp" />

                <!-- Section: Target Selections -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Target Selections"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/blue_header_bg"
                    android:layout_marginBottom="15dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aim Priority" android:textColor="#BBBBBB" android:textSize="10sp" android:textStyle="bold" android:layout_marginBottom="5dp" />
                <RadioGroup
                    android:id="@+id/aimby"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="15dp">
                    <RadioButton android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Distance" android:textColor="#FFFFFF" android:tag="0" android:buttonTint="#33B5E5" android:textSize="11sp" android:textStyle="bold"/>
                    <RadioButton android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Crosshair" android:textColor="#FFFFFF" android:tag="1" android:buttonTint="#33B5E5" android:textSize="11sp" android:textStyle="bold"/>
                </RadioGroup>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aim Trigger" android:textColor="#BBBBBB" android:textSize="10sp" android:textStyle="bold" android:layout_marginBottom="5dp" />
                <RadioGroup
                    android:id="@+id/aimwhen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="15dp">
                    <RadioButton android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ADS" android:textColor="#FFFFFF" android:tag="0" android:buttonTint="#33B5E5" android:textSize="11sp" android:textStyle="bold"/>
                    <RadioButton android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Firing" android:textColor="#FFFFFF" android:tag="1" android:buttonTint="#33B5E5" android:textSize="11sp" android:textStyle="bold"/>

                    <RadioButton
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#33B5E5"
                        android:tag="2"
                        android:text="Always"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Target Part" android:textColor="#BBBBBB" android:textSize="10sp" android:textStyle="bold" android:layout_marginBottom="5dp" />
                <RadioGroup
                    android:id="@+id/aimbotmode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">
                    <RadioButton android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Head" android:textColor="#FFFFFF" android:tag="0" android:buttonTint="#33B5E5" android:textSize="11sp" android:textStyle="bold"/>
                    <RadioButton android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Chest" android:textColor="#FFFFFF" android:tag="1" android:buttonTint="#33B5E5" android:textSize="11sp" android:textStyle="bold"/>
                </RadioGroup>

            </LinearLayout>

            <!-- Section: Other Options -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aimbot Toggles"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="6dp"
                android:background="@drawable/blue_header_bg"
                android:layout_marginBottom="15dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">
                
                <CheckBox
                    android:id="@+id/aimignorebot"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Ignore Bot"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:button="@null"
                    android:background="@drawable/tab_button_bg"
                    android:layout_marginEnd="5dp" />

                <CheckBox
                    android:id="@+id/aimknocked"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Ignore Knocked"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:button="@null"
                    android:background="@drawable/tab_button_bg"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="100dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
