<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:id="@+id/hackkkk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/main" 
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/licence_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/licence_will_be_expire_on"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAYS" android:textColor="#AAFFFFFF" android:textSize="8sp" />
                    </LinearLayout>

                    <TextView android:text=":" android:textColor="#FFFFFF" android:layout_marginHorizontal="8dp" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:id="@+id/hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HRS" android:textColor="#AAFFFFFF" android:textSize="8sp" />
                    </LinearLayout>

                    <TextView android:text=":" android:textColor="#FFFFFF" android:layout_marginHorizontal="8dp" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:id="@+id/minutes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MIN" android:textColor="#AAFFFFFF" android:textSize="8sp" />
                    </LinearLayout>

                    <TextView android:text=":" android:textColor="#FFFFFF" android:layout_marginHorizontal="8dp" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:id="@+id/second" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEC" android:textColor="#AAFFFFFF" android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/licencekey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="License Key" android:textColor="#CCFFFFFF" android:textSize="10sp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:id="@+id/keylicence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading..." android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" />
                            <ImageView android:id="@+id/eye_button" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="8dp" android:src="@drawable/ic_eye_off" app:tint="#FFFFFF" />
                        </LinearLayout>
                        <TextView android:id="@+id/devicetext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Device ID" android:textColor="#CCFFFFFF" android:textSize="10sp" android:layout_marginTop="4dp" />
                        <TextView android:id="@+id/deviceInfoTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="null" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fixinstall"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="FIX OBB"
                        android:textSize="10sp"
                        app:backgroundTint="#33F6F4F4"
                        app:strokeColor="#AAFFFFFF"
                        android:textColor="#000000"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

 <com.google.android.material.button.MaterialButton
    android:id="@+id/play"
    android:layout_width="200dp"
    android:layout_height="60dp"
    android:layout_gravity="end"
    android:textColor="#000000"
    android:text="PLAY"
    android:visibility="visible"
    app:backgroundTint="#A7D8FF" />

<com.google.android.material.button.MaterialButton
    android:id="@+id/hiderecord"
    android:layout_width="200dp"
    android:layout_height="60dp"
    android:layout_gravity="end"
    android:textColor="#000000"
    android:text="HIDE RECORD"
    android:visibility="visible"
    app:backgroundTint="#4CAF50" />

        <TextView
            android:id="@+id/mainver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 4.4.0"
            android:textColor="#86B8FF"
            android:textSize="12sp"
            android:layout_marginBottom="15dp"
            android:textStyle="bold"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="12dp" android:layout_marginBottom="10dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp">
                <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/circlebgmi" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PUBG MOBILE (IN)" android:textColor="#1E293B" android:textStyle="bold" />
                    <TextView android:id="@+id/vrindia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="com.pubg.imobile" android:textColor="#94A3B8" android:textSize="10sp" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/InstallBgmi" android:layout_width="80dp" android:layout_height="34dp" android:text="INSTALL" android:textColor="#FFFFFF" android:background="@drawable/btn_gradient_rounded" android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="12dp" android:layout_marginBottom="10dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp">
                <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/circlegl" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PUBG MOBILE (GL)" android:textColor="#1E293B" android:textStyle="bold" />
                    <TextView android:id="@+id/vrglobal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="com.tencent.ig" android:textColor="#94A3B8" android:textSize="10sp" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/InstallGlobal" android:layout_width="80dp" android:layout_height="34dp" android:text="INSTALL" android:textColor="#FFFFFF" android:background="@drawable/btn_gradient_rounded" android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="12dp" android:layout_marginBottom="10dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp">
                <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/krcircle" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PUBG MOBILE (KR)" android:textColor="#1E293B" android:textStyle="bold" />
                    <TextView android:id="@+id/vrkr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="com.pubg.krmobile" android:textColor="#94A3B8" android:textSize="10sp" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/InstallKR" android:layout_width="80dp" android:layout_height="34dp" android:text="INSTALL" android:textColor="#FFFFFF" android:background="@drawable/btn_gradient_rounded" android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="12dp" android:layout_marginBottom="10dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp">
                <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/circlevn" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PUBG MOBILE (VN)" android:textColor="#1E293B" android:textStyle="bold" />
                    <TextView android:id="@+id/vrvng" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="com.vng.pubgmobile" android:textColor="#94A3B8" android:textSize="10sp" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/InstallVNG" android:layout_width="80dp" android:layout_height="34dp" android:text="INSTALL" android:textColor="#FFFFFF" android:background="@drawable/btn_gradient_rounded" android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="12dp" android:layout_marginBottom="50dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp">
                <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/circletw" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PUBG MOBILE (TW)" android:textColor="#1E293B" android:textStyle="bold" />
                    <TextView android:id="@+id/vrtw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="com.republi.tw" android:textColor="#94A3B8" android:textSize="10sp" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/InstallTW" android:layout_width="80dp" android:layout_height="34dp" android:text="INSTALL" android:textColor="#FFFFFF" android:background="@drawable/btn_gradient_rounded" android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/registerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v4.4.0 | ENCRYPTED"
            android:layout_gravity="center"
            android:textColor="#EA000000"
            android:alpha="0.5"
            android:textSize="10sp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
