                        strcpy(data->PlayerUID, getNameByte(getA(pBase + OffsetsAll64::PlayerUID)));
                        if (strlen(data->PlayerNameByte) < 4)
                            continue;
                        if (strlen(data->PlayerNation) < 4)
                            continue;
                        if (strlen(data->PlayerUID) < 4)
                            continue;
                    }
                }
                if (response.PlayerCount >= maxplayerCount)
                    continue;
            if (data->HeadLocation.Z != 1.0f && (aimKnoced || data->Health > 0) && data->Distance <= aimDist && isVisibility == 1 && (!aimAI || !data->isBot) && (aimbot|| gEnable || aimTouch))
                {
                    float centerDist = sqrt((data->HeadLocation.X - width / 2) * (data->HeadLocation.X - width / 2) + (data->HeadLocation.Y - height / 2) * (data->HeadLocation.Y - height / 2));
                    if (centerDist < aimRadius)
                    {
                        if (aimBy != 1)
                            centerDist = data->Distance;
                        if (nearest > centerDist || nearest < 0)
                        {
                            nearest = centerDist;

                            if (aimFor == 1) {
                                targetLoc = GetBoneFromIndx(pBase, 5);
                            } else if (aimFor == 2) {
                                targetLoc = GetBoneFromIndx(pBase, 5);
                            } else {
                                targetLoc = GetBoneFromIndx(pBase, 3);
                            }


                            if(aimSpeed != 0) {
                                uintptr_t MovementComponent = getA(pBase + OffsetsAll64::CharacterMovement);
                                uintptr_t CurrentVehicle = getA(pBase + OffsetsAll64::CurrentVehicle);

                                if (CurrentVehicle)
                                {
                                    Vec3 LinearVelocity = getVec3(CurrentVehicle + OffsetsAll64::ReplicatedMovement);
                                    float Dist = getDistance(MyPos, targetLoc);
                                    auto timeToTravel = Dist / aimSpeed;
                                    targetLoc = Add_VectorVector(targetLoc, Multiply_VectorFloat(LinearVelocity, timeToTravel));
                                }
                                else
                                {
                                    auto Velocity = getVec3(MovementComponent + OffsetsAll64::Velocity);
                                    float Dist = getDistance(MyPos, targetLoc);
                                    auto timeToTravel = Dist / aimSpeed;
                                    targetLoc = Add_VectorVector(targetLoc, Multiply_VectorFloat(Velocity, timeToTravel));
                                }
                            }

                            if (psilent_aim_patch && gEnable) {
                                targetLocBt = targetLoc;
                                iovec iov{&targetLocBt, sizeof(targetLocBt)};
                                if (syscall(SYS_pwritev, gGMemFD, &iov, 1, base  + ps_Global_TargetFunc + ps_ShellCode_Aim3DPosition, 0) == sizeof(targetLocBt)){
                                    psilent_aim=true;
                                }
                            }

                            if(aimTouch) {
                                targetAimTouch = targetLoc;
                                targetAimTouch = World2Screen(cameraView, targetAimTouch);
                                float Dist = getDistance(MyPos, targetAimTouch);
                                float scope = cameraView.FOV;
                                float ok = 0;

                                if((int)Dist > 80)
                                    ok = Dist / Dist;
                                else if((int)Dist > 180)
                                    ok = Dist / 16;
                                else if((int)Dist > 270)
                                    ok = Dist / 8;
                                else if((int)Dist > 350)
                                    ok = Dist / 5;

                                if(slot == 2) {
                                    if(ads > 0) {
                                        recoilTouch = 0;
                                    }
                                    if(firing > 0){
                                        recoilTouch = recCom2;
                                    }
                                } else {
                                    if(ads > 0) {
                                        recoilTouch = 0;
                                    }
                                    if(firing > 0){
                                        recoilTouch = recCom1;
                                    }
                                }
                                if(!customScope) {
                                    targetAimTouch.Y += GetPitch(scope,recoilTouch,ok);
                                } else {
                                    targetAimTouch.Y += GetPitchCustom(scope,recoilTouch,ok,recScope);
                                }

                            }
                            cam = getVec3(cameraManager + OffsetsAll64::CameraCache + 0x10 + 0x0);
                            pointingAngle = CalcMousePos(targetLoc,cam);
                            pointingAngle.Y -= recCom / 100;
                        }
                    }
                }
                

                response.PlayerCount++;
            } else if (strstr(name, "VH") || (strstr(name, "PickUp_") && !strstr(name, "BP")) ||
                       strstr(name, "Rony") || strstr(name, "Mirado") || strstr(name, "LadaNiva") ||
                       strstr(name, "AquaRail")) {
                VehicleData* data = &response.Vehicles[response.VehicleCount];
                vm_readv(getA(pBase + OffsetsAll64::RootComponent) + OffsetsAll64::Position, &ObjPos, sizeof(ObjPos));
                uintptr_t Vehicle = getA(pBase + OffsetsAll64::VehicleCommon);
                data->Location = World2Screen(cameraView, ObjPos);
                if (data->Location.Z == 1.0f || data->Location.X > width + 200 || data->Location.X < -200)
                    continue;
                data->Distance = getDistance(MyPos, ObjPos);
                data->Fuel = getF(Vehicle + OffsetsAll64::VFuel) * 100 / getF(Vehicle + OffsetsAll64::VFuelMax);
                data->Health = getF(Vehicle + OffsetsAll64::VHealth) * 100 / getF(Vehicle + OffsetsAll64::VHealthMax);
                strcpy(data->VehicleName, name);
                if (response.VehicleCount >= maxvehicleCount) {
                    continue;
                }
                response.VehicleCount++;
            } else if (strstr(name, "Pickup_C") || strstr(name, "PickUp") ||
                       strstr(name, "BP_Ammo") || strstr(name, "BP_QK") ||
                       strstr(name, "Wrapper")) {
                ItemData *data = &response.Items[response.ItemsCount];
                vm_readv(getA(pBase + OffsetsAll64::RootComponent) + OffsetsAll64::Position,
                         &ObjPos, sizeof(ObjPos));
                data->Location = World2Screen(cameraView, ObjPos);
                if (data->Location.Z == 1.0f || data->Location.X > width + 100 ||
                    data->Location.X < -50)
                    continue;
                data->Distance = getDistance(MyPos, ObjPos);
                if (data->Distance > 1000.0f)
                    continue;
                strcpy(data->ItemName, name);
                if (response.ItemsCount >= maxitemsCount)
                    continue;
                response.ItemsCount++;
            }else if (strstr(name, "AirDropPlane") || strstr(name, "PlayerDeadInventoryBox_C") || strstr(name, "AirDropBox") || strstr(name, "AirDropSpacecraft")) {
                ItemData *data = &response.Items[response.ItemsCount];
                vm_readv(getA(pBase + OffsetsAll64::RootComponent) + OffsetsAll64::Position,
                         &ObjPos, sizeof(ObjPos));
                data->Location = World2Screen(cameraView, ObjPos);
                if (data->Location.Z == 1.0f || data->Location.X > width + 100 ||
                    data->Location.X < -50)
                    continue;
                data->Distance = getDistance(MyPos, ObjPos);
                strcpy(data->ItemName, name);
                if (response.ItemsCount >= maxitemsCount)
                    continue;
                response.ItemsCount++;
            } else if (strstr(name, "BP_Projectile_FragGrenade_C") || strstr(name, "BP_Grenade_Burn_C") ||
                       strstr(name, "BP_Projectile_BurnGrenade_C") || strstr(name, "BP_Projectile_StunGrenade_C") ||
                       strstr(name, "BP_Projectile_SmokeBomb_C")) {                       

                GrenadeData *data = &response.Grenade[response.GrenadeCount];
                vm_readv(getA(pBase + OffsetsAll64::RootComponent) + OffsetsAll64::Position,
                         &ObjPos, sizeof(ObjPos));
                data->Location = World2Screen(cameraView, ObjPos);
                data->Distance = getDistance(MyPos, ObjPos);
                if (data->Distance > 150.0f)
                    continue;
                if (strstr(name, "Shoulei"))
                    data->type = 1;
                else if (strstr(name, "Burn"))
                    data->type = 2;
                else if (strstr(name, "Stun"))
                    data->type = 3;
                else if (strstr(name, "Smoke"))
                    data->type = 4;
				if (response.GrenadeCount >= maxgrenadeCount)
				{
					continue;
				}
				response.GrenadeCount++;
			} 
					
            
            if (strstr(name, "PickUpListWrapperActor") || strstr(name, "AirDropListWrapperActor")) {
                BoxItemData *data = &response.BoxItems[response.BoxItemsCount];
                vm_readv(getA(pBase + OffsetsAll64::RootComponent) + OffsetsAll64::Position, &ObjPos, sizeof(ObjPos));
                data->Location = World2Screen(cameraView, ObjPos);
                if (data->Location.Z == 1.0f || data->Location.X > width + 100 || data->Location.X < -50)
                    continue;
                data->Distance = getDistance(MyPos, ObjPos);
                if (data->Distance > 150.0f)
                    continue;
                auto PickUpData = getA(pBase + OffsetsAll64::PickUpDataList);
                data->itemCount = getI(pBase + OffsetsAll64::PickUpDataList + sizeof(uintptr_t));
                for (int ij = 0; ij < data->itemCount; ij++) {
                    data->itemID[ij] = getI(PickUpData + (ij * 0x38 + 0x4));
                }
                if (response.BoxItemsCount >= maxboxitemsCount) {
                    continue;
                }
                response.BoxItemsCount++;
            }

        }


        if (response.PlayerCount + response.ItemsCount + response.VehicleCount +
            response.GrenadeCount + response.BoxItemsCount > 0)
            response.Success = true;
        send((void *) &response, sizeof(response));



  if ((firing || ads) && nearest > 0 && aimbot) {
                Writes(cameraManager + OffsetsAll64::ViewPitchMin,pointingAngle.Y); // float ViewPitchMin;//[Offset: 0x1c5c, Size: 0x4]
                Writes(cameraManager + OffsetsAll64::ViewPitchMax,pointingAngle.Y); // float ViewPitchMax;//[Offset: 0x1c60, Size: 0x4]
                Writes(cameraManager + OffsetsAll64::ViewYawMin,pointingAngle.X); // float ViewYawMin;//[Offset: 0x1c24, Size: 0x4]
                Writes(cameraManager + OffsetsAll64::ViewYawMax,pointingAngle.X); // float ViewYawMax;//[Offset: 0x1c28, Size: 0x4]
            } else {		
                Writes(cameraManager + OffsetsAll64::ViewPitchMin, -70.f);
                Writes(cameraManager + OffsetsAll64::ViewPitchMax, 75.f);
                Writes(cameraManager + OffsetsAll64::ViewYawMin, 0.0f);
                Writes(cameraManager + OffsetsAll64::ViewYawMax, 359.99899291992f);
            }

        if ((firing || ads) && nearest > 0 && aimTouch) {
            if (targetAimTouch != Vec3::Zero()) {
                aim_x = targetAimTouch.X;
                aim_y = targetAimTouch.Y;
            }
            isAim = true;
        } else {
            aim_x = 0;
            aim_y = 0;
            isAim = false;

        }

  if(gEnable) {
    if (!vngver) {
            if (Trigger && nearest > 0) {
                uint32_t first_word_in_target_func = 0x00000000;
                iovec iov{&first_word_in_target_func, sizeof(uint32_t)};
                if (syscall(SYS_preadv, gGMemFD, &iov, 1, base + ps_Global_TargetFunc, 0) == sizeof(uint32_t) && first_word_in_target_func == kTargetFuncOrigCode[0])
                {
                    iov = iovec{kTargetFuncShellCode, sizeof(kTargetFuncShellCode)};
                    iovec iovpatch{BypassBT_patch, sizeof(BypassBT_patch)};
                    if (syscall(SYS_pwritev, gGMemFD, &iov, 1, base + ps_Global_TargetFunc, 0) == sizeof(kTargetFuncShellCode) && syscall(SYS_pwritev, gGMemFD, &iovpatch, 1, base + ps_Global_Patch1, 0) == sizeof(BypassBT_patch))
                    {
                        psilent_aim_patch = true;
                    }
                }
            } else {
                iovec iov{kTargetFuncOrigCode, sizeof(kTargetFuncOrigCode)};
                syscall(SYS_pwritev, gGMemFD, &iov, 1, base + ps_Global_TargetFunc, 0);
                iovec iovpatch{BypassBT_orig, sizeof(BypassBT_orig)};
                syscall(SYS_pwritev, gGMemFD, &iovpatch, 1, base + ps_Global_Patch1, 0);
                psilent_aim_patch = false;
            }
            }
        } else if(!gEnable) {
        if (!vngver) {
            uint32_t first_word_in_target_func = 0x00000000;
            iovec iov{&first_word_in_target_func, sizeof(uint32_t)};
            if (syscall(SYS_preadv, gGMemFD, &iov, 1, base + ps_Global_TargetFunc, 0) == sizeof(uint32_t) && first_word_in_target_func != kTargetFuncOrigCode[0]) {
                iovec iov{kTargetFuncOrigCode, sizeof(kTargetFuncOrigCode)};
                syscall(SYS_pwritev, gGMemFD, &iov, 1, base + ps_Global_TargetFunc, 0);
                iovec iovpatch{BypassBT_orig, sizeof(BypassBT_orig)};
                syscall(SYS_pwritev, gGMemFD, &iovpatch, 1, base + ps_Global_Patch1, 0);
                psilent_aim_patch = false;
            }
}
}

        

    }
}

